{
  "name": "hires-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "tsx --env-file=.env --watch server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:indexes": "tsx --env-file=.env ingest/ensure-indexes.ts",
    "ingest:album": "tsx --env-file=.env ingest/ingest-album.ts",
    "ingest:neighbors": "tsx --env-file=.env ingest/neighbors.ts",
    "ingest:remove": "tsx --env-file=.env ingest/remove-track.ts",
    "royalties": "tsx --env-file=.env ingest/royalty-report.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.7.0",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "mongodb": "^6.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "mongodb-memory-server": "^10.1.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
